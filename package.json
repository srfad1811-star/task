{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "worker": "tsx worker.ts",
    "build": "vite build && esbuild server/vercelEntry.ts --bundle --platform=node --format=esm --packages=external --outfile=api/index.js",
    "vercel-build": "npm run build",
    "start": "node server.ts",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js api/index.js api/index.mjs",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1171.0",
    "@aws-sdk/s3-request-presigner": "^3.1171.0",
    "better-sqlite3": "^13.2.0",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "fast-xml-parser": "^5.12.1",
    "multer": "^2.5.0"
  },
  "devDependencies": {
    "@firebase/eslint-plugin-security-rules": "^0.0.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "esbuild": "^0.28.0",
    "eslint": "^10.15.0",
    "firebase": "^13.4.0",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0"
  }
}
